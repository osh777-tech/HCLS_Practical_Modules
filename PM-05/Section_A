void processFile(const std::string& inputPath, const std::string& outputPath, int key) {
    std::ifstream inputFile(inputPath, std::ios::binary);
    if (!inputFile) {
        std::cerr << "Error: Could not open input file: " << inputPath << std::endl;
        return;
    }

    std::ofstream outputFile(outputPath, std::ios::binary);
    if (!outputFile) {
        std::cerr << "Error: Could not open output file: " << outputPath << std::endl;
        return;
    }

    char byte;
    while (inputFile.read(&byte, 1)) {
        byte = byte ^ static_cast<char>(key); 
        outputFile.write(&byte, 1);
    }

    inputFile.close();
    outputFile.close();
    std::cout << "Operation successful. File saved as: " << outputPath << std::endl;
}

