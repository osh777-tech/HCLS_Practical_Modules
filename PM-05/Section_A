int runPA0121() {
	
	std::cout << "\n--- PA0121 ---\n";
    struct TriangleData {
        double sides[3];
    };
    
    TriangleData triangles[2];
    
    for (int i = 0; i < 2; ++i) {
        std::cout << "Enter 3 sides for triangle " << (i + 1) << " (a b c): ";
        std::cin >> triangles[i].sides[0] >> triangles[i].sides[1] >> triangles[i].sides[2];
    }
    
    for (int i = 0; i < 2; ++i) {
        double a = triangles[i].sides[0];
        double b = triangles[i].sides[1];
        double c = triangles[i].sides[2];
        
        double sides[3] = {a, b, c};
        std::sort(sides, sides + 3);
        a = sides[0];
        b = sides[1];
        c = sides[2];
        
        bool isValid = (a > 0) && (b > 0) && (c > 0) && (a + b > c);
        
        if (!isValid) {
            std::cout << "Triangle " << (i + 1) << ": Invalid (not a triangle)\n";
            continue;
        }
        
        const double EPS = 1e-9;
        bool isRight = std::abs((a * a + b * b) - (c * c)) < EPS;
        
        std::cout << "Triangle " << (i + 1) << ": Valid";
        if (isRight) {
            std::cout << " (Right-Angled)";
        } else {
            std::cout << " (Not Right-Angled)";
        }
        std::cout << "\n";
    }
    return 0;
}   

