    std::cin >> n;
    
    if (n < 0) {
        std::cout << "Factorial is not defined for negative numbers." << std::endl;
    } else {
        std::cout << "Factorial of " << n << " is: " << factorialIterative(n) << std::endl;
    }
    return 0;
}   

long long factorialRecursive(int n) {
    if (n < 0) return -1; 
    if (n == 0 || n == 1) return 1;
    
    return n * factorialRecursive(n - 1);
}

