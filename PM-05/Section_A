int runPA0110() {
    std::cout << "\n--- PA0110 ---\n";
    int n;
    std::cout << "Input any number: ";
    std::cin >> n;

    bool negative = (n < 0);
    n = std::abs(n);

    if (n < 10) {
        std::cout << "Single-digit number: " << n << std::endl;
        return 0;
    }

    int temp = n;
    int digits = 0;

    while (temp > 0) {
        digits++;
        temp /= 10;
    }

    int power10 = 1;
    for (int i = 1; i < digits; ++i) {
        power10 *= 10;
    }

    int first = n / power10;
    int last = n % 10;
    int middle = (n % power10) / 10;

    int swapped = last * power10 + middle * 10 + first;

    if (negative)
        swapped = -swapped;

    std::cout << "The number after swapping the first and last digits is: "
              << swapped << std::endl;
    return 0;
}

