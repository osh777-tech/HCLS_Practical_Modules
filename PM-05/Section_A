int runPA0114() {
	
	std::cout << "\n--- PA0114 ---\n";
    long long num;
    std::cout << "Enter an integer: ";
    if (!(std::cin >> num)) {
        std::cout << "Invalid input." << std::endl;
        return 1;
    }

    long long originalNum = num;
    long long temp = num;
    int n = 0;

    if (temp == 0) {
        n = 1;
    } else {
        while (temp != 0) {
            temp /= 10;
            ++n;
        }
    }

    temp = originalNum;
    long long sum = 0;
    if (temp == 0) {
        sum = 0;
    } else {
        while (temp != 0) {
            int digit = temp % 10;
            sum += std::pow(digit, n);
            temp /= 10;
        }
    }

    if (sum == originalNum) {
        std::cout << originalNum << " is an Armstrong number." << std::endl;
    } else {
        std::cout << originalNum << " is not an Armstrong number." << std::endl;
    }
    return 0;
}

int runPA0115() {
	
	std::cout << "\n--- PA0115 ---\n";
    int decimalNumber;
    std::cout << "Enter a decimal number: ";
    if (!(std::cin >> decimalNumber)) {
        std::cerr << "Invalid input." << std::endl;
        return 1;
    }

    std::string binaryString = "";
    int num = decimalNumber;
    
    if (num == 0) {
        binaryString = "0";
    } else {
        bool isNegative = false;
        if (num < 0) {
            isNegative = true;
            num = -num;
        }
        
        while (num > 0) {
            binaryString += ((num % 2) ? "1" : "0");
            num /= 2;
        }
        
        if (isNegative) {
            binaryString += "-";
        }
        
        std::string reversedBinary = "";
        for (int i = binaryString.length() - 1; i >= 0; i--) {
            reversedBinary += binaryString[i];
        }
        binaryString = reversedBinary;
    }

    std::cout << "Binary representation: " << binaryString << std::endl;
    return 0;
}   

