string scrambleWord(string word) {
	std::random_device rd; // 1. Create a random device to seed the generator
	std::mt19937 g(rd());  // 2. Initialize the generator engine
	std::shuffle(word.begin(), word.end(), g); // 3. Use std::shuffle and pass the engine as the 3rd argument
	
	return word;
}

