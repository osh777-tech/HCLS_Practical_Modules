// SECTION I: MINI DATABASE (PM-04-PS09)
// ==========================================

struct DBRecord {
    int id;
    std::string name;
    std::string phone;
};

class MiniDatabase {
private:
    std::vector<DBRecord> records;
    int nextId = 1;

public:
    // PA0901: Add people
    void addPerson(std::string name, std::string phone) {
        records.push_back({nextId++, name, phone});
        std::cout << "Added: " << name << " to database.\n";
    }

    // PA0902: Show added people
    void showAll() {
        if (records.empty()) {
            std::cout << "Database is empty.\n";
            return;
        }
        for (const auto& r : records) {
            std::cout << "ID: " << r.id << " | Name: " << r.name << " | Phone: " << r.phone << "\n";
        }
    }

    // PA0903: Save people to file
    void saveToFile() {
        std::ofstream outFile("database.txt");
        for (const auto& r : records) {
            outFile << r.id << "," << r.name << "," << r.phone << "\n";
        }
        outFile.close();
        std::cout << "Database saved to database.txt\n";
    }

    // PA0904: Load people from file
    void loadFromFile() {
        records.clear();
        std::ifstream inFile("database.txt");
        if (!inFile) {
            std::cout << "No existing database file found.\n";
            return;
        }
        std::string line;
        while (std::getline(inFile, line)) {
            // Simplified CSV parsing
            size_t pos1 = line.find(',');
            size_t pos2 = line.find(',', pos1 + 1);
            if (pos1 != std::string::npos && pos2 != std::string::npos) {
                int id = std::stoi(line.substr(0, pos1));
                std::string name = line.substr(pos1 + 1, pos2 - pos1 - 1);
                std::string phone = line.substr(pos2 + 1);
                records.push_back({id, name, phone});
                if (id >= nextId) nextId = id + 1;
            }
        }
        inFile.close();
        std::cout << "Database loaded successfully.\n";
    }

    // PA0905: Search database by typing a name
    void searchByName(std::string searchName) {
        bool found = false;
        for (const auto& r : records) {
            if (r.name == searchName) {
                std::cout << "Found -> ID: " << r.id << " | Name: " << r.name << "\n";
                found = true;
            }
        }
        if (!found) std::cout << "Person not found.\n";
    }

    // PA0906: Remove person by ID
    void removeById(int id) {
        auto it = std::remove_if(records.begin(), records.end(), [id](const DBRecord& r){ return r.id == id; });
        if (it != records.end()) {
            records.erase(it, records.end());
            std::cout << "Record ID " << id << " removed.\n";
        } else {
            std::cout << "ID not found.\n";
        }
    }
};


