void runSectionH() {
    std::cout << "\n--- SECTION H: Algorithms ---\n";
    std::vector<int> data = {5, 2, 8, 2, 9, 1, 7, 3};
    
    // Non-modifying (PA0801)
    int count_twos = std::count(data.begin(), data.end(), 2);
    std::cout << "Count of 2s: " << count_twos << "\n";
    
    // Modifying
    std::replace(data.begin(), data.end(), 2, 99);
    
    // Sorting & Binary Search
    std::sort(data.begin(), data.end());
    bool found = std::binary_search(data.begin(), data.end(), 8);
    std::cout << "Is 8 in sorted data? " << (found ? "Yes" : "No") << "\n";
    
    // Min/Max
    auto minmax = std::minmax_element(data.begin(), data.end());
    std::cout << "Min: " << *minmax.first << " | Max: " << *minmax.second << "\n";
    
    // Heap
    std::make_heap(data.begin(), data.end());
    std::cout << "Heap root (max): " << data.front() << "\n";
}

