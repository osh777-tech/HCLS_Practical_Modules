// PA0110: Point class
class Point {
protected:
    double x, y;
public:
    // PA0107: Give a default value for the constructor method
    Point(double x_val = 0.0, double y_val = 0.0) : x(x_val), y(y_val) {} 
    
    // PA0205: Call a destructor (Virtual Destructor for safe polymorphism)
    virtual ~Point() {
        // Destructor logic
    }
    
    // PA0204: Declare a virtual function
    virtual void display() const { 
        std::cout << "Point Location: (" << x << ", " << y << ")" << std::endl;
    }
};

// PA0110: Point2D class
class Point2D : public Point {
public:
    Point2D(double x_val = 0.0, double y_val = 0.0) : Point(x_val, y_val) {}
    
    // PA0203: Override the base function of a class
    void display() const override {
        std::cout << "Point2D Coordinates -> X: " << x << ", Y: " << y << std::endl;
    }

    // PA0202: Invoke operator overloading
    Point2D operator+(const Point2D& other) const {
        return Point2D(this->x + other.x, this->y + other.y);
    }
};

// PA0104: Write a class that represents the user with a unique identifier
class User {
private:
    std::string username;
    int uniqueID;
    static int idCounter;

public:
    // PA0109: Call a constructor using constructor (Delegating constructor)
    User() : User("Guest") {} 

    // PA0106: Create constructor converts (Converting string to User)
    User(std::string name) {
        username = name;
        uniqueID = ++idCounter;
    }

    // PA0105: Use the copy constructor
    User(const User& other) {
        username = other.username + " (Copy)";
        uniqueID = ++idCounter; 
    }

    // PA0108: Call constructors and destructors
    ~User() {}

    // PA0103: Create a method inside a class
    void showUserDetails() const {
        std::cout << "User ID: " << uniqueID << " | Name: " << username << std::endl;
    }
};
int User::idCounter = 1000;


