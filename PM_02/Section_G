#include <iostream>

using namespace std;

int main()
{
    
    cout << " ------FOR LOOP------" << endl;
    
    //Declare/initialise loop control variable (i) and run a For Loop
    for (int i = 1; i <= 3; i++)
    {
        //Execute the loop body
        cout << "For loop iteration: " << i << endl;
    }
    cout << "    \n---- DO-WHILE LOOP ----" << endl;
    //Declare and initialise do-while loop
    int counter = 1;
    do {
        cout << "Do-while interation: " << counter << endl;
        counter++;
    } while (counter <= 3);
    
    cout << "\n --- NESTED DO-WHILE LOOP ---" << endl;
    
    //Create nested do-while loop
    int outer = 1;
    do{
        cout << "Outer loop is at: " << outer << endl;
        
        //This inner loop runs completely for every single step of the outer loop
        int inner = 1;
        do{
            cout << "     -> Inner loop is at: " << inner << endl;
            inner++;
        } while (inner <= 2);
        
        outer++;
    } while (outer <= 2);
    
    return 0;
}
