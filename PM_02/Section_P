#include <iostream>

using namespace std;

class Point {
    public:
        int x, y;
        
        //Constructor to set up our points
        Point(int xCoord = 0, int yCoord = 0) {
            
            x = xCoord;
            y = yCoord;
        }
        
        //Overload an operator
        //We are teaching the '+' operator how to add two Point objects together!
        Point operator + (Point const &otherPoint) {
            Point result;
            result.x = x + otherPoint.x; //Add the x values
            result.y = y + otherPoint.y; //Add the y values
            
            return result;
        }
};

int main() {
    
    cout << " ====== OPERATOR OVERLOADING =======" << endl;
    
    //Let's create two points
    Point p1(10, 5);
    Point p2( 2, 4);
    
    cout << "Point 1: X = " << p1.x << " | Y = " << p1.y << endl;
    cout << "Point 2: Y =  " << p2.x << " | Y = " << p2.y << "\n" << endl;
    
    //We here then use the standard '+' sign. (my fav. part of this program)
    //but our overloaded operator handles it for our custom objects!
    Point p3 = p1 + p2;
    
    cout << "Result of Point 1 + Point 2: " << endl;
    cout << "Point 3: X = " << p3.x << " | Y = " << p3.y << endl;

    return 0;
}
