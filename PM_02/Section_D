#include <iostream>

using namespace std;

int main() {
    double num1, num2;
    char operation;

    // Prompting the user for interactive input
    cout << "===== P4SC4L CALCULATOR =====" << endl;
    cout << "Enter the first number: ";
    cin >> num1;

    cout << "Enter an operator (+, -, *, /): ";
    cin >> operation;

    cout << "Enter the second number: ";
    cin >> num2;

    cout << "-----------------------------" << endl;

    // Using conditions to process the math based on the user's input
    if (operation == '+') {
        cout << "Result: " << num1 << " + " << num2 << " = " << (num1 + num2) << endl;
    } 
    else if (operation == '-') {
        cout << "Result: " << num1 << " - " << num2 << " = " << (num1 - num2) << endl;
    } 
    else if (operation == '*') {
        cout << "Result: " << num1 << " * " << num2 << " = " << (num1 * num2) << endl;
    } 
    else if (operation == '/') {
        // PA0401: Making the calculator resistant to dividing by zero 
        if (num2 == 0) {
            cout << "Math Error: You cannot divide by zero!" << endl;
        } else {
            cout << "Result: " << num1 << " / " << num2 << " = " << (num1 / num2) << endl;
        }
    } 
    else {
        // Handling invalid symbols
        cout << "Input Error: Invalid operator chosen." << endl;
    }

    return 0;
}
